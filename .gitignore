node_modules/
dist/
*.log
*.docx
~$*
.claude/
.vscode/
.private/

# Build artifacts
data/export/
data/git-config.json

# Downloaded reading fonts — run `npm run fonts` to fetch them.
public/fonts/

# ──────────────────────────────────────────────────────────────────────
# Content is private by default. The shipped demo books are the one
# exception — their files are explicitly whitelisted below. To track
# your own writing in this clone, edit this file.
#
# Archive (events, pieces, entities, taxonomy) lives PER-BOOK at
# data/books/{bookId}/archive/ — it ships or doesn't ship along with
# the book that contains it.
# ──────────────────────────────────────────────────────────────────────

data/meta.json
data/drafts/

# Legacy: data/chapters/ at root was the pre-per-book chapter store.
# Engine now reads from data/books/{id}/chapters/, but ignore any
# leftover root-level chapters.
data/chapters/

# Books — ignore everything under data/books/ except the shipped demos (zh + en)
data/books/*
!data/books/book-murloc-demo/
!data/books/book-murloc-demo/**
!data/books/book-murloc-demo-en/
!data/books/book-murloc-demo-en/**

# Standalone HTML drafts / scratch reports
Html/

# Personal long-form notes — entire feature omitted from public
notes/
public/notes/
