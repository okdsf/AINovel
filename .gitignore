# ──────────────────────────────────────────────────────────────────────
# Private content paths — kept empty in the public repo. The publish
# pipeline only ships taxonomy.json and the _example/ seed files.
# ──────────────────────────────────────────────────────────────────────

# Books, chapters, conversations, drafts
data/books.json
data/meta.json
data/books/
data/chapters/
