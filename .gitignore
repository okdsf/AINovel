# Build artifacts
data/export/
data/git-config.json

# Downloaded reading fonts — run `npm run fonts` to fetch them.
public/fonts/

# ──────────────────────────────────────────────────────────────────────
# Content is private by default. The shipped demo book is the one
# exception — its files are explicitly whitelisted below. To track your
# own writing in this clone, edit this file.
# ──────────────────────────────────────────────────────────────────────

data/meta.json
data/drafts/

# data/chapters/ is legacy (engine reads from data/books/{id}/chapters/)
data/chapters/

# Books — ignore everything under data/books/ except the shipped demos (zh + en)
data/books/*
!data/books/book-murloc-demo/
!data/books/book-murloc-demo/**
!data/books/book-murloc-demo-en/
!data/books/book-murloc-demo-en/**

# Archive — ignore everything except the demo event + pieces + taxonomy
data/archive/events/*
!data/archive/events/evt-murloc-whitehouse.json

data/archive/pieces/*
!data/archive/pieces/piece-cnn-murloc-whitehouse/
!data/archive/pieces/piece-fox-murloc-whitehouse/

data/archive/entities/*

# Standalone HTML drafts / scratch reports
Html/

# Personal long-form notes — entire feature omitted from public
notes/
public/notes/
