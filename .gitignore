# Archive — keep the example seeds + the demo story, ignore everything else.
data/archive/events/*
!data/archive/events/_example.json
!data/archive/events/evt-murloc-whitehouse.json

data/archive/pieces/*
!data/archive/pieces/_example/
!data/archive/pieces/piece-cnn-murloc-whitehouse/
!data/archive/pieces/piece-fox-murloc-whitehouse/

data/archive/entities/*
!data/archive/entities/_example.json

# Standalone HTML drafts / scratch reports
Html/

# Personal long-form notes (only the index page is shipped)
notes/
public/notes/*.html
!public/notes/index.html
